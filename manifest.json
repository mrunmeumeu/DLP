{
  "manifest_version": 3,
  "name": "File Upload Interceptor",
  "description": "Intercept file uploads and validate .txt, .xlsx, .docx, and .pdf files for sensitive content.",
  "version": "4.37",
  

  "permissions": [
    
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://mail.google.com/*",
    "*://drive.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://mail.google.com/*",
        "*://drive.google.com/*"
      ],
      "js": [
        "xlsx.full.min.js",
        "mammoth.browser.min.js",
        "pdf.min.js",
        "pdf.worker.min.js",
        "jszip.min.js", 
        "contentScript.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"  
  },
  "web_accessible_resources": [
    {
      "resources": ["admin.html"], 
      "matches": ["<all_urls>"]    
    }
  ]
}
